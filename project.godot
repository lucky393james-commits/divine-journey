[gd_project]

config_version=5
godot_version="4.3"

[application]

config/name="Divine Journey"
config/description="3D Educational Action RPG inspired by Bhutan's history, geography, culture, and environment"
config/version="0.1.0"
config/icon="res://assets/icon.png"
run/main_scene="res://scenes/main/main.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[physics]

3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="forward_plus"
environment/ambient_light/enabled=true
environment/ambient_light/energy=1.0
